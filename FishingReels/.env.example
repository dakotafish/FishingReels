# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fishingreels

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fishingreels

# MediaMTX -> backend webhooks (publish auth + stream lifecycle hooks).
# Shared secret; the MediaMTX container gets it via compose interpolation.
MEDIAMTX_WEBHOOK_SECRET=dev-webhook-secret-change-me
