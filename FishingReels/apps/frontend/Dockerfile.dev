FROM node:22-alpine

WORKDIR /app

# Cache deps in a layer that depends only on package files
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

# Source comes in via bind mount in dev compose; this COPY makes the image
# self-sufficient if anyone ever builds without the bind mount.
COPY . .

EXPOSE 5173

# --host 0.0.0.0 binds Vite to all interfaces so the host can reach it
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
